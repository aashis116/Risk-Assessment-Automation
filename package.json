{
  "name": "risk-alert-triage-bot",
  "version": "1.0.0",
  "description": "Playwright-driven TPRM automation: onboards/assesses vendors visually, then polls for risk changes and files GitHub tickets",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf test-results playwright-report allure-results allure-report",
    "pretest": "npm run clean",
    "test": "playwright test",
    "report:generate": "allure generate allure-results -o allure-report",
    "report:open": "allure open allure-report",
    "report": "npm run report:generate && npm run report:open",
    "test:report": "npm test && npm run report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "dotenv": "^18.0.1",
    "nodemailer": "^10.0.10",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "allure": "^3.18.0",
    "allure-playwright": "^3.12.2",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
